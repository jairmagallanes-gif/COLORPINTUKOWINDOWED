# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE INTEGRATION (ColorLink Pintuco DB)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# GROQ API (Llama / Qwen fast AI inference for diagnoses and finishing simulations)
GROQ_API_KEY=

# GOOGLE MAPS PLATFORM API KEY (Live dispatch tracking and logistics)
VITE_GOOGLE_MAPS_API_KEY=

# GMAIL NOTIFICATION SERVICE (Official dispatch email account)
# For production sending via Gmail SMTP, use a 16-character Google App Password (Contraseña de Aplicación)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# OFFICIAL WHATSAPP DISPATCH NUMBER (Colombia country code 57 + number)
COMPANY_WHATSAPP=
COMPANY_NAME=


# Privileged server-side key (keep private; never use a VITE_ prefix).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
